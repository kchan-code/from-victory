<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- FV-721. App-target manifest. Tracking is off. Collected types match the
	     nutrition-label intent in docs/ios-app-store-release.md section 9,
	     including the hosted WebView, not only native APIs. Checked against
	     the live App Store Connect answers on 2026-11-13 (FV-722): the six
	     types, purposes, linked and tracking values below match the published
	     label. Keep the two in step when either changes. Date of birth has no dedicated
	     manifest type; it is declared as Other Data Types. Do not switch that
	     to Sensitive Info: Apple's sensitive category is racial, health,
	     religious, biometric, and similar data, which this app does not collect. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Required-reason APIs audited 2026-11-13 UTC against the app target and the
	     plugins it links. None of these call UserDefaults, file-timestamp,
	     disk-space, system-boot-time, or active-keyboard APIs:
	       FVNarrationPlugin.swift (FileManager temp files, AVAudioSession playback)
	       FVAppleIAPPlugin.swift (StoreKit 2)
	       FVAuthPlugin.swift (ASWebAuthenticationSession, Sign in with Apple)
	       Capacitor 8 core (UserDefaults replaced by a file-backed KeyValueStore;
	         its own PrivacyInfo.xcprivacy declares an empty API list)
	       CapacitorApp, CapacitorSplashScreen, CapacitorStatusBar
	     NSPrivacyAccessedAPITypes is therefore empty. If a privacy report from
	     an archive names a missing reason, add only that API. Do not pre-declare
	     UserDefaults or a crash SDK. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Email is a parent's address, or an 18+ athlete's own address.
		     A 13-17 athlete account has no real email. The sign-in identifier
		     is system-generated and is not a working address (privacy policy;
		     docs/ios-app-store-release.md §9). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<!-- FV-722: Analytics as well as App Functionality. First-party usage
			     events (app opened, session started or finished) are used to
			     count active and returning athletes. Matches the App Store
			     Connect label as corrected on 2026-11-13. -->
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
